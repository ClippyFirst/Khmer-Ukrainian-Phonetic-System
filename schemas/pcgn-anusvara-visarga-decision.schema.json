      "maxItems": 3
    },
    "series": {
      "enum": [
        "â",
        "ô",
        null
      ]
    },
    "coda_character": {
      "enum": [
        "ង",
        null
      ]
    },
    "romanization": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_table_row": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
