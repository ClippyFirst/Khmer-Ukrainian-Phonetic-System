{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ClippyFirst/Khmer-Ukrainian-Phonetic-System-/blob/main/schemas/khmer-vowel-context-register.schema.json",
  "title": "Khmer contextual vowel evidence register",
  "description": "Validates source-indexed contextual vowel evidence. This schema does not adjudicate IPA or authorize runtime rule promotion.",
  "type": "object",
  "required": ["schema_version", "purpose", "status_vocabulary", "sources", "cases", "coverage_policy"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "purpose": { "type": "string", "minLength": 1 },
    "status_vocabulary": {
      "type": "object",
      "required": ["SOURCE_ATTESTED_NOT_GOLD", "CONFLICTING_SOURCE_ANALYSES", "NOT_ESTABLISHED"],
      "properties": {
        "SOURCE_ATTESTED_NOT_GOLD": { "type": "string", "minLength": 1 },
        "CONFLICTING_SOURCE_ANALYSES": { "type": "string", "minLength": 1 },
        "NOT_ESTABLISHED": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["url", "role"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "orthography", "grapheme_structure", "base_consonant_class",
          "register_condition", "phonological_interpretation", "ipa",
          "ipa_source", "ukrainian_adaptation", "ukrainian_status",
          "evidence_level", "status", "limitations"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^KHV-[0-9]{3,}$" },
          "orthography": { "type": "string", "minLength": 1 },
          "grapheme_structure": {
            "type": "object",
            "required": ["base", "dependent_vowels", "subscripts", "register_shifter", "coda"],
            "properties": {
              "base": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                ]
              },
              "dependent_vowels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "subscripts": { "type": "array", "items": { "type": ["string", "null"] } },
              "register_shifter": { "type": ["string", "null"] },
              "coda": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": ["string", "null"] } },
                  { "type": "null" }
                ]
              }
            },
            "additionalProperties": true
          },
          "base_consonant_class": { "type": "string", "minLength": 1 },
          "register_condition": { "type": "string", "minLength": 1 },
          "phonological_interpretation": { "type": "string", "minLength": 1 },
          "ipa": { "type": ["string", "null"] },
          "ipa_source": { "type": "string", "minLength": 1 },
          "ukrainian_adaptation": { "type": ["string", "null"] },
          "ukrainian_status": { "type": "string", "minLength": 1 },
          "evidence_level": {
            "enum": ["SOURCE_ATTESTED_NOT_GOLD", "CONFLICTING_SOURCE_ANALYSES", "NOT_ESTABLISHED"]
          },
          "status": {
            "enum": ["SOURCE_ATTESTED_NOT_GOLD", "CONFLICTING_SOURCE_ANALYSES", "NOT_ESTABLISHED"]
          },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "alternatives": { "type": "array", "items": { "type": "object" } },
          "selection_criterion": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "coverage_policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
