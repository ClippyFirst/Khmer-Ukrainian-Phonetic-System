{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BGN/PCGN 1972 Note 10 romanization character inventory decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_text",
    "status",
    "recognized_special_letters",
    "unsupported_letters",
    "non_letter_characters",
    "codepoint_trace",
    "source_locator",
    "warnings"
  ],
  "properties": {
    "source_text": {"type": "string"},
    "status": {"enum": ["VALID", "UNSUPPORTED_LETTER"]},
    "recognized_special_letters": {
      "type": "array",
      "items": {
        "enum": ["â", "Â", "ă", "Ă", "á", "Á", "ê", "Ê", "ĕ", "Ĕ", "é", "É", "ĭ", "Ĭ", "ô", "Ô", "ó", "Ó", "ŏ", "Ŏ", "œ", "Œ", "œ̆", "Œ̆", "ŭ", "Ŭ"]
      }
    },
    "unsupported_letters": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1}},
    "non_letter_characters": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1}},
    "codepoint_trace": {"type": "array", "items": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"}},
    "source_locator": {"const": "PCGN 1972, Note 10 (p. 5)"},
    "warnings": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALID"}}, "required": ["status"]},
      "then": {"properties": {"unsupported_letters": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "UNSUPPORTED_LETTER"}}, "required": ["status"]},
      "then": {"properties": {"unsupported_letters": {"minItems": 1}}}
    }
  ]
}
