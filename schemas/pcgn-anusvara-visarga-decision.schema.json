            "enum": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_table_row": {
            "const": 8
          }
        },
        "required": [
          "source_table_row"
        ]
      },
      "then": {
        "properties": {
          "coda_character": {
