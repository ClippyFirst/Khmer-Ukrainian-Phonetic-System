    "warnings": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "RESOLVED"}}, "required": ["status"]},
      "then": {"properties": {"series": {"enum": ["â", "ô"]}, "onset_romanization": {"type": "string", "minLength": 1}, "vowel_romanization": {"type": "string", "minLength": 1}, "coda_romanization": {"type": "string", "minLength": 1}, "romanization": {"type": "string", "minLength": 1}, "onset_table_rows": {"minItems": 1}, "vowel_table_row": {"type": "integer"}, "coda_table_row": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"status": {"const": "UNRESOLVED"}}, "required": ["status"]},
      "then": {"properties": {"series": {"const": null}, "onset_romanization": {"const": null}, "vowel_romanization": {"const": null}, "coda_romanization": {"const": null}, "romanization": {"const": null}, "onset_table_rows": {"maxItems": 0}, "vowel_table_row": {"const": null}, "coda_table_row": {"const": null}}}
