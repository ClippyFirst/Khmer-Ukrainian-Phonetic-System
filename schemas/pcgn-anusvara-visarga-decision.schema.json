          },
          "ipa": {
            "type": "null"
          },
          "ukrainian": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_table_row": {
            "const": 7
          }
        },
        "required": [
          "source_table_row"
        ]
      },
      "then": {
        "properties": {
          "source_components": {
            "const": [
              "េ",
              "ា",
              "ះ"
            ]
          }
        }
