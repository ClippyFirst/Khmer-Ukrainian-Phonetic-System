{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ClippyFirst/Khmer-Ukrainian-Phonetic-System-/blob/main/schemas/khmer-vowel-context-register.schema.json",
  "title": "Khmer contextual vowel evidence register",
  "description": "Validates source-indexed contextual vowel evidence. This schema does not adjudicate IPA or authorize runtime rule promotion.",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "status_vocabulary",
    "sources",
    "cases",
    "coverage_policy",
    "reference_mapping_inventory"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status_vocabulary": {
      "type": "object",
      "required": [
        "SOURCE_ATTESTED_NOT_GOLD",
        "CONFLICTING_SOURCE_ANALYSES",
        "NOT_ESTABLISHED"
      ],
      "properties": {
        "SOURCE_ATTESTED_NOT_GOLD": {
          "type": "string",
          "minLength": 1
        },
        "CONFLICTING_SOURCE_ANALYSES": {
          "type": "string",
          "minLength": 1
        },
        "NOT_ESTABLISHED": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "url",
          "role"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "orthography",
          "grapheme_structure",
          "base_consonant_class",
          "register_condition",
          "phonological_interpretation",
          "ipa",
          "ipa_source",
          "ukrainian_adaptation",
          "ukrainian_status",
          "evidence_level",
          "status",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KHV-[0-9]{3,}$"
          },
          "orthography": {
            "type": "string",
            "minLength": 1
          },
          "grapheme_structure": {
            "type": "object",
            "required": [
              "base",
              "dependent_vowels",
              "subscripts",
              "register_shifter",
              "coda"
            ],
            "properties": {
              "base": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "dependent_vowels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subscripts": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "register_shifter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "coda": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": true
          },
          "base_consonant_class": {
            "type": "string",
            "minLength": 1
          },
          "register_condition": {
            "type": "string",
            "minLength": 1
          },
          "phonological_interpretation": {
            "type": "string",
            "minLength": 1
          },
          "ipa": {
            "type": [
              "string",
              "null"
            ]
          },
          "ipa_source": {
            "type": "string",
            "minLength": 1
          },
          "ukrainian_adaptation": {
            "type": [
              "string",
              "null"
            ]
          },
          "ukrainian_status": {
            "type": "string",
            "minLength": 1
          },
          "evidence_level": {
            "enum": [
              "SOURCE_ATTESTED_NOT_GOLD",
              "CONFLICTING_SOURCE_ANALYSES",
              "NOT_ESTABLISHED"
            ]
          },
          "status": {
            "enum": [
              "SOURCE_ATTESTED_NOT_GOLD",
              "CONFLICTING_SOURCE_ANALYSES",
              "NOT_ESTABLISHED"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "selection_criterion": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "coverage_policy": {
      "type": "string",
      "minLength": 1
    },
    "context_dimensions": {
      "type": "array",
      "description": "Source-backed context-level findings; these describe dimensions and bounded evidence, not deterministic IPA lookup rows.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "environment",
          "finding",
          "source_ids",
          "locator",
          "profile_scope",
          "evidence_status",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PPH-CTX-[0-9]{3,}$"
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "profile_scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "BOUNDED_ACOUSTIC_PERCEPTUAL_SAMPLE",
              "BOUNDED_ACOUSTIC_SAMPLE",
              "BOUNDED_PROFILE_SPECIFIC_REPORT",
              "BOUNDED_STYLE_SPECIFIC_ACOUSTIC_SAMPLE",
              "ORTHOGRAPHIC_STRUCTURE_ESTABLISHED_PHONETIC_PARSE_CONTEXTUAL",
              "RECENT_BOUNDED_PROSODIC_EVIDENCE",
              "SOURCE_ATTESTED_NOT_GOLD",
              "SOURCE_REPORTED_CONTEXT_DEPENDENT",
              "SOURCE_REPORTED_NOT_EXPERIMENTALLY_VERIFIED",
              "SOURCE_REPORTED_WITH_EXCEPTIONS"
            ]
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "coda_pattern_observations": {
      "type": "array",
      "description": "Source-attested rhyme-pattern observations; these are not lexical words, independent gold, or runtime rules.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern",
          "base_consonant_class",
          "source_ipa",
          "source_id",
          "source_locator",
          "evidence_status",
          "profile_scope",
          "ukrainian_adaptation",
          "ukrainian_status",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "base_consonant_class": {
            "type": "string",
            "minLength": 1
          },
          "source_ipa": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "const": "SOURCE_ATTESTED_NOT_GOLD"
          },
          "profile_scope": {
            "type": "string",
            "minLength": 1
          },
          "ukrainian_adaptation": {
            "type": [
              "string",
              "null"
            ]
          },
          "ukrainian_status": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "lexical_coda_examples": {
      "type": "array",
      "description": "Lexical spellings paired with a source-specific non-IPA phonological transcription; never import that transcription into IPA.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "orthography",
          "source_phonological_transcription",
          "transcription_system",
          "gloss",
          "phonological_context",
          "source_id",
          "source_locator",
          "profile_scope",
          "evidence_status",
          "ipa",
          "ukrainian_adaptation",
          "ukrainian_status",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KHV-LEX-[0-9]{3,}$"
          },
          "orthography": {
            "type": "string",
            "minLength": 1
          },
          "source_phonological_transcription": {
            "type": "string",
            "minLength": 1
          },
          "transcription_system": {
            "type": "string",
            "minLength": 1
          },
          "gloss": {
            "type": "string",
            "minLength": 1
          },
          "phonological_context": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "profile_scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "const": "SOURCE_ATTESTED_NOT_GOLD"
          },
          "ipa": {
            "type": "null"
          },
          "ukrainian_adaptation": {
            "type": "null"
          },
          "ukrainian_status": {
            "const": "NOT_ESTABLISHED"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "lexical_stress_examples": {
      "type": "array",
      "description": "Source-attested examples of stress-marking orthography paired with a source-specific non-IPA transcription.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "orthography",
          "source_phonological_transcription",
          "transcription_system",
          "gloss",
          "phonological_context",
          "source_id",
          "source_locator",
          "profile_scope",
          "evidence_status",
          "ipa",
          "ukrainian_adaptation",
          "ukrainian_status",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KHV-STRESS-[0-9]{3,}$"
          },
          "orthography": {
            "type": "string",
            "minLength": 1
          },
          "source_phonological_transcription": {
            "type": "string",
            "minLength": 1
          },
          "transcription_system": {
            "type": "string",
            "minLength": 1
          },
          "gloss": {
            "type": "string",
            "minLength": 1
          },
          "phonological_context": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "profile_scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "const": "SOURCE_ATTESTED_NOT_GOLD"
          },
          "ipa": {
            "type": "null"
          },
          "ukrainian_adaptation": {
            "type": "null"
          },
          "ukrainian_status": {
            "const": "NOT_ESTABLISHED"
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "reference_mapping_inventory": {
      "type": "object",
      "description": "Metadata-only pointer to a third-party specialist reference table. No source values are copied while redistribution rights are unknown.",
      "required": [
        "source_id",
        "source_locator",
        "reported_table_rows",
        "license_status",
        "redistribution_status",
        "runtime_eligible",
        "data_values_copied",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "const": "r12a-orthography"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "reported_table_rows": {
          "type": "integer",
          "const": 54
        },
        "license_status": {
          "type": "string",
          "const": "UNKNOWN_NO_EXPLICIT_LICENSE_LOCATED"
        },
        "redistribution_status": {
          "type": "string",
          "const": "BLOCKED_PENDING_EXPLICIT_PERMISSION_OR_CLEAR_LICENSE"
        },
        "runtime_eligible": {
          "const": false
        },
        "data_values_copied": {
          "const": false
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
